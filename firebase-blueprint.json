{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Mining procurement requisition order with manual items and live status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "siteCode": { "type": "string" },
        "departmentCode": { "type": "string" },
        "departmentName": { "type": "string" },
        "requestedFrom": { "type": "string" },
        "executionDays": { "type": "string" },
        "year": { "type": "string" },
        "sequenceNumber": { "type": "number" },
        "orderDate": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterEmail": { "type": "string" },
        "purpose": { "type": "string" },
        "priority": { "type": "string" },
        "pagesCount": { "type": "number" },
        "status": { "type": "string" },
        "urgencyAlertSent": { "type": "boolean" },
        "items": { "type": "array" },
        "approvals": { "type": "array" },
        "createdAt": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "referenceNumber", "status", "items", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and roles for the WDM mining procurement portal",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "siteCode": { "type": "string" },
        "departmentCode": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Comprehensive security and operational audit trail including item modifications, content diffs, approvals, and status transitions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "details": { "type": "string" },
        "ipAddress": { "type": "string" },
        "severity": { "type": "string" },
        "category": { "type": "string" },
        "orderId": { "type": "string" },
        "orderReference": { "type": "string" },
        "itemChanges": { "type": "array" },
        "fieldDiffs": { "type": "array" },
        "summaryChanges": { "type": "array" }
      },
      "required": ["id", "timestamp", "action", "details"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Mining procurement requisition orders accessible via link and tracking"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles tracking authenticated users, roles, and site affiliations"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable procurement audit records tracking order content alterations and stage changes"
    }
  }
}
